{
  "name": "agent-synapse",
  "version": "0.1.0",
  "description": "Shared memory layer that lets AI coding agents (Claude Code, Codex...) hand off context to each other — no copy-paste.",
  "type": "module",
  "bin": {
    "agent-synapse": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "web": "node web/server.js",
    "handoffs": "node scripts/show-handoffs.mjs",
    "connect": "node scripts/install.mjs",
    "config": "node scripts/print-config.mjs",
    "clear": "node scripts/clear-handoffs.mjs",
    "autopickup": "node scripts/autopickup.mjs",
    "test": "node scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  }
}
